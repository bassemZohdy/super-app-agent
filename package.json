{
  "name": "super-app-agent-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cityside local city-services demo with authenticated provider simulators and a custom UI/event contract",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*",
    "mini-apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:backend": "node --env-file-if-exists=.env --experimental-strip-types scripts/dev-backend.ts",
    "dev:react": "npm run dev --workspace=apps/shell-react",
    "dev:angular": "npm run dev --workspace=apps/shell-angular",
    "dev:flutter": "cd apps/shell-flutter && flutter run -d chrome --web-port 3002",
    "build": "turbo run build",
    "test": "node --experimental-strip-types --import ./scripts/test-env.ts --test packages/protocol-core/test/*.ts services/test/*.ts test/*.ts",
    "test:record": "node --experimental-strip-types scripts/record-e2e-scenarios.ts",
    "test:video": "node --experimental-strip-types scripts/record-video-scenarios.ts",
    "lint": "eslint apps packages services mini-apps scripts test --max-warnings 0",
    "check:docs": "node --experimental-strip-types scripts/check-docs.ts",
    "check:secrets": "node --experimental-strip-types scripts/check-secrets.ts",
    "check": "npm run lint && npm run check:docs && npm run check:secrets && npm test && npm run build -- --concurrency=2",
    "test:keycloak": "node --experimental-strip-types scripts/test-keycloak.ts",
    "demo:up": "docker compose -f docker-compose.demo.yml up -d && npm run demo:wait",
    "demo:wait": "node --experimental-strip-types scripts/wait-demo-stack.ts",
    "demo:down": "docker compose -f docker-compose.demo.yml down",
    "demo:logs": "docker compose -f docker-compose.demo.yml logs -f",
    "demo:verify:security": "node --experimental-strip-types scripts/verify-demo-security.ts",
    "demo:verify": "node --experimental-strip-types scripts/verify-demo-stack.ts",
    "openapi:generate": "node --experimental-strip-types scripts/generate-provider-openapi.ts",
    "test:redis": "node --experimental-strip-types --import ./scripts/test-env.ts --test test/integration/redis-sessions.ts",
    "demo:realm": "node --env-file-if-exists=.env --experimental-strip-types scripts/configure-demo-keycloak.ts",
    "demo:verify:journeys": "node --experimental-strip-types scripts/verify-demo-journeys.ts",
    "demo:verify:restart": "node --experimental-strip-types scripts/run-demo-restart.ts",
    "demo:verify:manual": "node --experimental-strip-types scripts/verify-demo-manual.ts",
    "demo:check:openrouter": "node --env-file-if-exists=.env --experimental-strip-types scripts/check-openrouter.ts"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "ajv": "8.17.1",
    "eslint": "10.13.0",
    "playwright": "^1.64.1",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "superapp",
    "agentic-ai",
    "langgraph",
    "openrouter",
    "mcp",
    "ag-ui",
    "a2-ui",
    "microservices",
    "microfrontends",
    "react",
    "angular",
    "flutter"
  ],
  "author": "Bassem Reda Zohdy <bassem.zohdy@gmail.com>",
  "license": "MIT",
  "packageManager": "npm@11.9.0"
}
