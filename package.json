{
  "name": "super-app-agent-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cityside local city-services demo with authenticated provider simulators and a custom UI/event contract",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*",
    "mini-apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:backend": "node --env-file-if-exists=.env --experimental-strip-types scripts/dev-backend.ts",
    "dev:react": "npm run dev --workspace=apps/shell-react",
    "dev:angular": "npm run dev --workspace=apps/shell-angular",
    "dev:flutter": "cd apps/shell-flutter && flutter run -d chrome --web-port 3002",
    "build": "turbo run build",
    "test": "node --experimental-strip-types --import ./scripts/test-env.ts --test packages/protocol-core/test/*.ts services/test/*.ts test/*.ts",
    "test:record": "node --experimental-strip-types scripts/record-e2e-scenarios.ts",
    "test:video": "node --experimental-strip-types scripts/record-video-scenarios.ts",
    "lint": "eslint apps packages services mini-apps scripts test --max-warnings 0",
    "check:docs": "node --experimental-strip-types scripts/check-docs.ts",
    "check:secrets": "node --experimental-strip-types scripts/check-secrets.ts",
    "check": "npm run lint && npm run check:e2e && npm run check:docs && npm run check:secrets && npm test && npm run build -- --concurrency=2",
    "test:keycloak": "node --experimental-strip-types scripts/test-keycloak.ts",
    "demo:up": "docker compose -f docker-compose.demo.yml up -d && npm run demo:wait && npm run demo:delegation:realm && npm run local-ai:up",
    "demo:wait": "node --experimental-strip-types scripts/wait-demo-stack.ts",
    "demo:down": "docker compose -f docker-compose.demo.yml --profile local-ai down",
    "demo:logs": "docker compose -f docker-compose.demo.yml logs -f",
    "demo:verify:security": "node --experimental-strip-types scripts/verify-demo-security.ts",
    "demo:verify": "node --experimental-strip-types scripts/verify-demo-stack.ts",
    "openapi:generate": "node --experimental-strip-types scripts/generate-provider-openapi.ts",
    "test:redis": "node --experimental-strip-types --import ./scripts/test-env.ts --test test/integration/redis-sessions.ts",
    "demo:realm": "node --env-file-if-exists=.env --experimental-strip-types scripts/configure-demo-keycloak.ts",
    "demo:verify:journeys": "node --experimental-strip-types scripts/verify-demo-journeys.ts",
    "demo:verify:restart": "node --experimental-strip-types scripts/run-demo-restart.ts",
    "demo:verify:manual": "node --experimental-strip-types scripts/verify-demo-manual.ts",
    "demo:check:openrouter": "node --env-file-if-exists=.env --experimental-strip-types scripts/check-openrouter.ts",
    "test:e2e": "node --experimental-strip-types scripts/record-e2e-scenarios.ts",
    "recordings:serve": "node --experimental-strip-types scripts/serve-recordings.ts",
    "check:e2e": "tsc --project scripts/e2e/tsconfig.json",
    "demo:delegation:realm": "DELEGATION_ENABLED=true npm run demo:realm",
    "demo:verify:delegation": "node --experimental-strip-types scripts/verify-demo-delegation.ts",
    "demo:verify:delegation:security": "docker compose -f docker-compose.demo.yml exec -T delegation-broker node --experimental-strip-types scripts/verify-demo-delegation-security.ts",
    "record:delegation": "node --experimental-strip-types scripts/record-delegation.ts",
    "local-ai:up": "node --experimental-strip-types scripts/local-ai-up.ts",
    "local-ai:verify": "node --experimental-strip-types scripts/verify-local-ai.ts",
    "local-ai:test": "docker compose -f docker-compose.demo.yml exec -T voice python -m unittest -v test_api",
    "local-ai:browser": "node --experimental-strip-types scripts/verify-local-ai-browser.ts",
    "demo:verify:payment-accounts": "node --experimental-strip-types scripts/e2e/payment-accounts.ts",
    "demo:verify:payment-ledger": "node --experimental-strip-types scripts/verify-payment-ledger.ts",
    "simulator": "node --experimental-strip-types scripts/simulator.ts",
    "simulator:verify": "node --experimental-strip-types scripts/verify-simulator.ts",
    "demo:verify:inventory": "node --experimental-strip-types scripts/verify-payment-inventory.ts",
    "demo:verify:payment-authorization": "node --experimental-strip-types scripts/e2e/payment-authorization.ts",
    "demo:verify:wallet-funding": "node --experimental-strip-types scripts/e2e/wallet-funding.ts",
    "record:wallet-funding": "node --experimental-strip-types scripts/e2e/wallet-funding.ts --record",
    "demo:verify:fine-checkout": "node --experimental-strip-types scripts/e2e/fine-checkout.ts",
    "record:fine-checkout": "node --experimental-strip-types scripts/e2e/fine-checkout.ts --record",
    "demo:verify:recharge-checkout": "node --experimental-strip-types scripts/e2e/recharge-checkout.ts",
    "record:recharge-checkout": "node --experimental-strip-types scripts/e2e/recharge-checkout.ts --record",
    "demo:verify:checkout-groups": "node --experimental-strip-types scripts/e2e/checkout-groups.ts",
    "record:checkout-groups": "node --experimental-strip-types scripts/e2e/checkout-groups.ts --record",
    "demo:verify:payment-refunds": "node --experimental-strip-types scripts/e2e/payment-refunds.ts",
    "record:payment-refunds": "node --experimental-strip-types scripts/e2e/payment-refunds.ts --record",
    "demo:verify:payment-events": "node --experimental-strip-types scripts/e2e/payment-events.ts",
    "record:payment-events": "node --experimental-strip-types scripts/e2e/payment-events.ts --record"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "ajv": "8.17.1",
    "eslint": "10.13.0",
    "playwright": "^1.64.1",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "superapp",
    "agentic-ai",
    "langgraph",
    "openrouter",
    "mcp",
    "ag-ui",
    "a2-ui",
    "microservices",
    "microfrontends",
    "react",
    "angular",
    "flutter"
  ],
  "author": "Bassem Reda Zohdy <bassem.zohdy@gmail.com>",
  "license": "MIT",
  "packageManager": "npm@11.9.0"
}
