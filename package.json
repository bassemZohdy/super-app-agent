{
  "name": "super-app-agent-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cityside local city-services demo with authenticated provider simulators and a custom UI/event contract",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*",
    "mini-apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:backend": "node --env-file-if-exists=.env --experimental-strip-types scripts/dev-backend.ts",
    "dev:react": "npm run dev --workspace=apps/shell-react",
    "dev:angular": "npm run dev --workspace=apps/shell-angular",
    "dev:flutter": "cd apps/shell-flutter && flutter run -d chrome --web-port 3002",
    "build": "turbo run build",
    "test": "node --experimental-strip-types --import ./scripts/test-env.ts --test packages/protocol-core/test/*.ts services/test/*.ts test/*.ts",
    "test:record": "node --experimental-strip-types scripts/record-e2e-scenarios.ts",
    "test:browser": "playwright test -c test/browser/playwright.config.ts",
    "test:video": "node --experimental-strip-types scripts/record-video-scenarios.ts",
    "lint": "eslint apps packages services mini-apps scripts test --max-warnings 0",
    "progress": "node --experimental-strip-types scripts/progress.ts",
    "check:docs": "node --experimental-strip-types scripts/check-docs.ts",
    "check:secrets": "node --experimental-strip-types scripts/check-secrets.ts",
    "tokens:generate": "node --experimental-strip-types scripts/generate-tokens.ts",
    "check:tokens": "node --experimental-strip-types scripts/generate-tokens.ts --check && node --experimental-strip-types scripts/check-raw-colors.ts",
    "colors:baseline": "node --experimental-strip-types scripts/check-raw-colors.ts --update",
    "verify:network": "node --experimental-strip-types scripts/verify-network-isolation.ts",
    "check:any": "node --experimental-strip-types scripts/check-any-types.ts",
    "any:baseline": "node --experimental-strip-types scripts/check-any-types.ts --update",
    "check:local-only": "node --experimental-strip-types scripts/check-local-only.ts",
    "check": "npm run lint && npm run check:e2e && npm run check:docs && npm run check:secrets && npm run check:local-only && npm run check:any && npm run check:shell-contracts && npm run check:tokens && npm test && npm run build -- --concurrency=2",
    "test:keycloak": "node --experimental-strip-types scripts/test-keycloak.ts",
    "demo:up": "docker compose -f docker-compose.demo.yml up -d && npm run demo:wait && npm run demo:delegation:realm && npm run local-ai:up",
    "demo:refresh": "npm run demo:delegation:realm && node --experimental-strip-types scripts/refresh-demo-apis.ts && npm run demo:wait",
    "demo:wait": "node --experimental-strip-types scripts/wait-demo-stack.ts",
    "qualify": "node --experimental-strip-types scripts/qualification-stack.ts",
    "demo:down": "docker compose -f docker-compose.demo.yml --profile local-ai down",
    "demo:logs": "docker compose -f docker-compose.demo.yml logs -f",
    "demo:verify:security": "node --experimental-strip-types scripts/verify-demo-security.ts",
    "demo:verify": "node --experimental-strip-types scripts/verify-demo-stack.ts",
    "openapi:generate": "node --experimental-strip-types scripts/generate-provider-openapi.ts",
    "openapi:generate:apps": "node --experimental-strip-types scripts/generate-application-openapi.ts",
    "sbom:generate": "node --experimental-strip-types scripts/generate-sbom.ts",
    "test:redis": "node --experimental-strip-types --import ./scripts/test-env.ts --test test/integration/redis-sessions.ts",
    "demo:realm": "node --env-file-if-exists=.env --experimental-strip-types scripts/configure-demo-keycloak.ts",
    "demo:verify:journeys": "node --experimental-strip-types scripts/verify-demo-journeys.ts",
    "demo:verify:restart": "node --experimental-strip-types scripts/run-demo-restart.ts",
    "demo:verify:manual": "node --experimental-strip-types scripts/verify-demo-manual.ts",
    "test:e2e": "node --experimental-strip-types scripts/record-e2e-scenarios.ts",
    "recordings:serve": "node --experimental-strip-types scripts/serve-recordings.ts",
    "check:e2e": "tsc --project scripts/e2e/tsconfig.json",
    "demo:delegation:realm": "DELEGATION_ENABLED=true npm run demo:realm",
    "demo:verify:delegation": "node --experimental-strip-types scripts/verify-demo-delegation.ts",
    "demo:verify:delegation:security": "docker compose -f docker-compose.demo.yml exec -T delegation-broker node --experimental-strip-types scripts/verify-demo-delegation-security.ts",
    "record:delegation": "node --experimental-strip-types scripts/record-delegation.ts",
    "local-ai:up": "node --experimental-strip-types scripts/local-ai-up.ts",
    "local-ai:verify": "node --experimental-strip-types scripts/verify-local-ai.ts",
    "local-ai:test": "docker compose -f docker-compose.demo.yml exec -T voice python -m unittest -v test_api",
    "local-ai:browser": "node --experimental-strip-types scripts/verify-local-ai-browser.ts",
    "demo:verify:payment-accounts": "node --experimental-strip-types scripts/e2e/payment-accounts.ts",
    "demo:verify:payment-ledger": "node --experimental-strip-types scripts/verify-payment-ledger.ts",
    "simulator": "node --experimental-strip-types scripts/simulator.ts",
    "simulator:verify": "node --experimental-strip-types scripts/verify-simulator.ts",
    "demo:verify:inventory": "node --experimental-strip-types scripts/verify-payment-inventory.ts",
    "demo:verify:payment-authorization": "node --experimental-strip-types scripts/e2e/payment-authorization.ts",
    "demo:verify:wallet-funding": "node --experimental-strip-types scripts/e2e/wallet-funding.ts",
    "record:wallet-funding": "node --experimental-strip-types scripts/e2e/wallet-funding.ts --record",
    "demo:verify:fine-checkout": "node --experimental-strip-types scripts/e2e/fine-checkout.ts",
    "record:fine-checkout": "node --experimental-strip-types scripts/e2e/fine-checkout.ts --record",
    "demo:verify:recharge-checkout": "node --experimental-strip-types scripts/e2e/recharge-checkout.ts",
    "record:recharge-checkout": "node --experimental-strip-types scripts/e2e/recharge-checkout.ts --record",
    "demo:verify:checkout-groups": "node --experimental-strip-types scripts/e2e/checkout-groups.ts",
    "record:checkout-groups": "node --experimental-strip-types scripts/e2e/checkout-groups.ts --record",
    "demo:verify:payment-refunds": "node --experimental-strip-types scripts/e2e/payment-refunds.ts",
    "record:payment-refunds": "node --experimental-strip-types scripts/e2e/payment-refunds.ts --record",
    "demo:verify:payment-events": "node --experimental-strip-types scripts/e2e/payment-events.ts",
    "record:payment-events": "node --experimental-strip-types scripts/e2e/payment-events.ts --record",
    "simulator:console": "node --experimental-strip-types scripts/scenario-console.ts",
    "simulator:issuer": "node --experimental-strip-types scripts/e2e/issuer-scenarios.ts",
    "demo:verify:issuer-scenarios": "node --experimental-strip-types scripts/e2e/issuer-scenarios.ts",
    "record:issuer-scenarios": "node --experimental-strip-types scripts/e2e/issuer-scenarios.ts --record",
    "demo:verify:automation-execution": "node --experimental-strip-types scripts/e2e/automation-execution.ts",
    "demo:verify:automation-kill-switch": "node --experimental-strip-types scripts/e2e/automation-kill-switch-broker.ts",
    "demo:verify:mandate-narrowing": "node --experimental-strip-types scripts/e2e/mandate-narrowing.ts",
    "demo:verify:mandate-create": "node --experimental-strip-types scripts/e2e/mandate-create.ts",
    "demo:verify:mandate-change": "node --experimental-strip-types scripts/e2e/mandate-change.ts",
    "demo:verify:kill-switch-panel": "node --experimental-strip-types scripts/e2e/kill-switch-panel.ts",
    "demo:verify:mandates": "node --experimental-strip-types scripts/e2e/payment-mandates.ts",
    "demo:verify:payment-surfaces": "node --experimental-strip-types scripts/e2e/payment-surfaces.ts",
    "record:payment-surfaces": "node --experimental-strip-types scripts/e2e/payment-surfaces.ts --record",
    "demo:verify:legacy-payment-events": "node --experimental-strip-types scripts/e2e/legacy-payment-events.ts",
    "record:legacy-payment-events": "node --experimental-strip-types scripts/e2e/legacy-payment-events.ts --record",
    "demo:verify:payment-reconciliation": "node --experimental-strip-types scripts/e2e/payment-reconciliation.ts",
    "record:payment-reconciliation": "node --experimental-strip-types scripts/e2e/payment-reconciliation.ts --record",
    "demo:verify:payment-history": "node --experimental-strip-types scripts/e2e/payment-history.ts",
    "record:payment-history": "node --experimental-strip-types scripts/e2e/payment-history.ts --record",
    "demo:verify:automation-security": "node --experimental-strip-types scripts/e2e/automation-security.ts",
    "demo:verify:delegation:restart": "node --experimental-strip-types scripts/verify-delegation-restart.ts",
    "demo:payment-access": "node --env-file-if-exists=.env --experimental-strip-types scripts/payment-access.ts",
    "demo:verify:payment-lifecycle": "node --experimental-strip-types scripts/e2e/payment-lifecycle.ts",
    "record:payment-lifecycle": "node --experimental-strip-types scripts/e2e/payment-lifecycle.ts --record",
    "demo:verify:payment-obligations": "node --experimental-strip-types scripts/e2e/payment-obligations.ts",
    "record:journeys": "node --experimental-strip-types scripts/record-journeys.ts",
    "record:payment-obligations": "node --experimental-strip-types scripts/e2e/payment-obligations.ts --record",
    "ops:init": "node --experimental-strip-types scripts/ops.ts init",
    "ops:inspect": "node --env-file-if-exists=.env --experimental-strip-types scripts/ops.ts inspect",
    "ops:backup": "node --env-file-if-exists=.env --experimental-strip-types scripts/ops.ts backup",
    "ops:restore": "node --env-file-if-exists=.env --experimental-strip-types scripts/ops.ts restore",
    "ops:verify": "node --experimental-strip-types scripts/verify-operations.ts",
    "ops:verify:recovery": "node --experimental-strip-types scripts/verify-operations-recovery.ts",
    "start": "node --env-file=.env.agent --experimental-strip-types services/agent-core/src/orchestrator/main.ts",
    "agent:init": "node --experimental-strip-types scripts/init-simple-agent.ts",
    "agent:verify:container": "node --experimental-strip-types scripts/verify-agent-container.ts",
    "agent:client": "node --env-file=.env.agent --experimental-strip-types scripts/simple-agent-client.ts",
    "agent:verify:model": "node --env-file=.env.agent --experimental-strip-types scripts/verify-agent-model.ts",
    "test:agent": "node --experimental-strip-types --test services/test/simple-agent.test.ts services/test/agent-model-config.test.ts services/test/focused-agent-client.test.ts services/agent-core/test/*.test.ts",
    "check:agent": "npm run build --workspace services/agent-core && tsc -p services/agent-core/test/tsconfig.json && npm run test:agent",
    "generate:shell-contracts": "node --experimental-strip-types scripts/generate-shell-contracts.ts",
    "check:shell-contracts": "node --experimental-strip-types scripts/generate-shell-contracts.ts --check",
    "build:flutter": "cd apps/shell-flutter && flutter build web --no-web-resources-cdn && cd ../.. && node --experimental-strip-types scripts/localize-flutter-assets.ts",
    "demo:flutter": "node --experimental-strip-types scripts/serve-flutter-web.ts",
    "agent:qualify:model": "node --env-file=.env.agent --experimental-strip-types scripts/verify-agent-qualification.ts"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "ajv": "8.20.0",
    "eslint": "10.13.0",
    "playwright": "^1.64.1",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "superapp",
    "agentic-ai",
    "langgraph",
    "mcp",
    "ag-ui",
    "a2-ui",
    "microservices",
    "microfrontends",
    "react",
    "angular",
    "flutter"
  ],
  "author": "Bassem Reda Zohdy <bassem.zohdy@gmail.com>",
  "license": "MIT",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
