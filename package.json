{
  "name": "super-app-agent-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Next-Generation Agentic SuperApp Platform with AG-UI / A2-UI protocols and Polyglot Frontends",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*",
    "mini-apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:backend": "turbo run dev --filter=\"./services/*\"",
    "dev:react": "npm run dev --workspace=apps/shell-react",
    "dev:angular": "npm run dev --workspace=apps/shell-angular",
    "dev:flutter": "cd apps/shell-flutter && flutter run -d chrome",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "superapp",
    "agentic-ai",
    "langgraph",
    "openrouter",
    "mcp",
    "ag-ui",
    "a2-ui",
    "microservices",
    "microfrontends",
    "react",
    "angular",
    "flutter"
  ],
  "author": "Bassem Reda Zohdy <bassem.zohdy@gmail.com>",
  "license": "MIT"
}
