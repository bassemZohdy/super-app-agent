{
  "name": "@superapp/shell-angular",
  "version": "1.0.0",
  "private": true,
  "description": "Cityside Angular reference shell with Keycloak login and a custom UI renderer",
  "scripts": {
    "dev": "ng serve --port 3001 --proxy-config proxy.config.cjs",
    "build": "node --experimental-strip-types ../../scripts/angular-environment.ts && ng build"
  },
  "dependencies": {
    "@angular/common": "20.3.34",
    "@angular/core": "20.3.34",
    "@angular/platform-browser": "20.3.34",
    "@superapp/protocol-core": "*",
    "@superapp/ui-tokens": "*",
    "rxjs": "^7.8.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "20.3.42",
    "@angular/cli": "20.3.42",
    "@angular/compiler": "20.3.34",
    "@angular/compiler-cli": "20.3.34",
    "typescript": "~5.9.3"
  }
}
