{
  "name": "@superapp/shell-angular",
  "version": "1.0.0",
  "private": true,
  "description": "Cityside Angular reference shell with Keycloak login and a custom UI renderer",
  "scripts": {
    "dev": "ng serve --port 3001 --proxy-config proxy.config.cjs",
    "build": "node --experimental-strip-types ../../scripts/angular-environment.ts && ng build"
  },
  "dependencies": {
    "@angular/common": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@superapp/protocol-core": "*",
    "@superapp/ui-tokens": "*",
    "rxjs": "^7.8.1",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.0",
    "@angular/cli": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/compiler-cli": "^18.2.0",
    "typescript": "^5.5.0"
  }
}
