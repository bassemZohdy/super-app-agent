# ==============================================================================
# SuperApp Agent Configuration
# ==============================================================================

# OpenRouter API Key for Backend Autonomous Agent Orchestrator
# Obtain your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# LLM Model Selector for Agent Planner
# Examples:
# - anthropic/claude-3.5-sonnet
# - google/gemini-2.0-flash-001
# - openai/gpt-4o
# - meta-llama/llama-3.3-70b-instruct
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Agentic Platform Settings (LangGraph / LangChain)
# Optional: Enable LangSmith observability for agent tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=superapp-agent-demo

# Backend Ingress & Microservices Port Allocation
PORT_AGENTGATEWAY_EDGE=8080
PORT_AGENT_CORE=4000
PORT_GATEWAY=4000
PORT_SERVICE_RIDE=4001
PORT_SERVICE_FOOD=4002
PORT_SERVICE_WALLET=4003
PORT_SERVICE_CATALOG=4004
PORT_SERVICE_PROFILE=4005

# Keycloak OIDC Authentication Server
PORT_KEYCLOAK=8085
KEYCLOAK_URL=http://localhost:8085
KEYCLOAK_REALM=superapp
KEYCLOAK_CLIENT_ID=superapp-shell
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Frontend Dev Ports
PORT_SHELL_REACT=3000
PORT_SHELL_ANGULAR=3001
PORT_SHELL_FLUTTER=3002

# Runtime Mode: 'standalone' (single runner process) or 'microservices' (distributed services)
BACKEND_RUNTIME_MODE=microservices

# Node Environment
NODE_ENV=development
LOG_LEVEL=info
