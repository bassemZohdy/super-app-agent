# ==============================================================================
# SuperApp Agent Configuration
# ==============================================================================

# OpenRouter key for live, context-aware concierge replies; keep keys server-side
# Obtain your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Default: free model router. For stable tests choose an available :free model from OpenRouter's current catalog.
OPENROUTER_MODEL=openrouter/free
ENABLE_LIVE_LLM=true
OPENROUTER_ALLOW_PAID_MODELS=false
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Reserved placeholders: the current agent implementation is not a real LangGraph runtime.
# LangSmith integration is not enabled by simply setting these values.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=superapp-agent-demo

# Backend Ingress & Microservices Port Allocation
PORT_AGENTGATEWAY_EDGE=8080
PORT_AGENT_CORE=4000
PORT_GATEWAY=4000
PORT_SERVICE_RIDE=4001
PORT_SERVICE_FOOD=4002
PORT_SERVICE_WALLET=4003
PORT_SERVICE_CATALOG=4004
PORT_SERVICE_PROFILE=4005

# Keycloak OIDC Authentication Server
PORT_KEYCLOAK=8085
KEYCLOAK_URL=http://localhost:8085
KEYCLOAK_REALM=superapp
KEYCLOAK_CLIENT_ID=superapp-shell
# Exact token issuer, audience, and reachable JWKS endpoint are required outside demo.
KEYCLOAK_ISSUER=http://localhost:8085/realms/superapp
KEYCLOAK_AUDIENCE=agent-core
KEYCLOAK_JWKS_URL=http://localhost:8085/realms/superapp/protocol/openid-connect/certs
# Explicit local testing only. Never works under NODE_ENV=production.
DEMO_AUTH=false
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
KEYCLOAK_ADMIN=admin
# Local Keycloak demo credentials: never expose this realm or reuse for production.
KEYCLOAK_ADMIN_PASSWORD=admin

# Frontend Dev Ports
PORT_SHELL_REACT=3000
PORT_SHELL_ANGULAR=3001
PORT_SHELL_FLUTTER=3002

# Legacy hint only: actual mode is selected by npm run dev:backend or Docker Compose.
# Legacy fixture runner uses direct handlers; docker-compose.demo.yml selects REST integration.
BACKEND_RUNTIME_MODE=microservices

# Node Environment
NODE_ENV=development
LOG_LEVEL=info

# Full integrated demo is configured by docker-compose.demo.yml.
# These defaults preserve the lightweight fixture runner when Docker is not used.
PROVIDER_INTEGRATION=false
DOMAIN_TRANSPORT=local
SESSION_STORE=memory
REDIS_URL=redis://127.0.0.1:6379
SESSION_TTL_SECONDS=3600
APP_DATA_DIR=.data/application
PORT_SERVICE_TELECOM=4006
# Browser issuer stays public; container token/JWKS URLs are set by Compose.
KEYCLOAK_PUBLIC_ISSUER=http://localhost:8085/realms/superapp
KEYCLOAK_TOKEN_URL=http://localhost:8085/realms/superapp/protocol/openid-connect/token
# Demo-only confidential clients imported by the seeded realm; never use these in production.
SERVICE_RIDE_CLIENT_SECRET=demo-ride-secret
SERVICE_FOOD_CLIENT_SECRET=demo-food-secret
SERVICE_WALLET_CLIENT_SECRET=demo-wallet-secret
SERVICE_CATALOG_CLIENT_SECRET=demo-catalog-secret
SERVICE_PROFILE_CLIENT_SECRET=demo-profile-secret
SERVICE_TELECOM_CLIENT_SECRET=demo-telecom-secret
PROVIDER_SETTLEMENT_SECRET=demo-settlements-secret
