{
  "openapi": "3.1.0",
  "info": {
    "title": "RTA Simulator",
    "version": "2.1.0",
    "description": "Local synthetic API. Signed interactive user identity or broker-issued user token with current exact-operation grant required. JWT subject owns the account; caller user headers do not grant authority. A separate read-only settlement machine lane retrieves captured charge proofs. Legacy fixture mode is outside this reference security profile."
  },
  "servers": [
    {
      "url": "http://localhost:4101"
    }
  ],
  "security": [
    {
      "accessToken": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "security": [],
        "responses": {
          "200": {
            "description": "Process health"
          }
        }
      }
    },
    "/v1/accounts": {
      "get": {
        "operationId": "listAccounts",
        "description": "List personal and household accounts belonging to the trusted actor.",
        "responses": {
          "200": {
            "description": "Accounts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "accounts": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": true
                      },
                      "maxItems": 100
                    }
                  },
                  "required": [
                    "success",
                    "accounts"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/accounts/{accountId}/settlement-attempts/{paymentId}": {
      "get": {
        "operationId": "rta_inspectSettlementAttempt",
        "description": "Inspect an owned persisted settlement fence and safely retry its gateway acknowledgement/release. Historical used-payment records can reconcile as applied.",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          {
            "name": "paymentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "settlement": {
                      "type": "object",
                      "properties": {
                        "attemptId": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200
                        },
                        "paymentId": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200
                        },
                        "state": {
                          "enum": [
                            "PENDING",
                            "APPLIED",
                            "RELEASED"
                          ]
                        },
                        "gatewayConfirmed": {
                          "type": "boolean"
                        },
                        "failureCode": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200
                        }
                      },
                      "required": [
                        "attemptId",
                        "paymentId",
                        "state",
                        "gatewayConfirmed"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "success",
                    "settlement"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "402": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
