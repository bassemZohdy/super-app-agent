{
  "openapi": "3.1.0",
  "info": {
    "title": "Dubai Police Simulator",
    "version": "2.2.0",
    "description": "Local synthetic API. Signed interactive user identity or broker-issued user token with current exact-operation grant required. JWT subject owns the account; caller user headers do not grant authority. A separate read-only settlement machine lane retrieves captured charge proofs. Legacy fixture mode is outside this reference security profile."
  },
  "servers": [
    {
      "url": "http://localhost:4105"
    }
  ],
  "security": [
    {
      "accessToken": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "security": [],
        "responses": {
          "200": {
            "description": "Process health"
          }
        }
      }
    },
    "/v1/accounts": {
      "get": {
        "operationId": "listAccounts",
        "description": "List personal and household accounts belonging to the trusted actor.",
        "responses": {
          "200": {
            "description": "Accounts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "accounts": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": true
                      },
                      "maxItems": 100
                    }
                  },
                  "required": [
                    "success",
                    "accounts"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/v1/accounts/{accountId}/payables": {
      "get": {
        "operationId": "police_listVersionedPayables",
        "description": "Read provider-owned revisioned obligations, including settled/withdrawn history and effective discounts.",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "payables": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 200
                          },
                          "provider": {
                            "enum": [
                              "dewa",
                              "etisalat",
                              "du",
                              "police"
                            ]
                          },
                          "reference": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 200
                          },
                          "obligationId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 200
                          },
                          "kind": {
                            "enum": [
                              "BILL",
                              "FINE"
                            ]
                          },
                          "version": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 1000000
                          },
                          "label": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 200
                          },
                          "amountMinor": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 100000000
                          },
                          "originalAmountMinor": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 100000000
                          },
                          "discountMinor": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 100000000
                          },
                          "discountEligible": {
                            "type": "boolean"
                          },
                          "currency": {
                            "const": "AED"
                          },
                          "status": {
                            "enum": [
                              "UNPAID",
                              "PAID",
                              "CANCELLED",
                              "EXPIRED"
                            ]
                          },
                          "dueState": {
                            "enum": [
                              "CURRENT",
                              "DUE",
                              "OVERDUE",
                              "EXPIRED",
                              "CLOSED"
                            ]
                          },
                          "revision": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}$"
                          },
                          "dueDate": {
                            "type": "string",
                            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                          },
                          "expiresAt": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 200
                          },
                          "discountExpiresAt": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 200
                          },
                          "period": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 200
                          },
                          "openingFixture": {
                            "type": "boolean"
                          },
                          "paymentRestricted": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "id",
                          "provider",
                          "reference",
                          "obligationId",
                          "kind",
                          "version",
                          "label",
                          "amountMinor",
                          "originalAmountMinor",
                          "discountMinor",
                          "discountEligible",
                          "currency",
                          "status",
                          "dueState",
                          "revision"
                        ],
                        "additionalProperties": false
                      },
                      "maxItems": 100
                    }
                  },
                  "required": [
                    "success",
                    "payables"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "402": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
